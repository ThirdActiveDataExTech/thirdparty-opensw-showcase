# ─── 데이터베이스 (docker-compose 기본값 기준) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metadata
DB_USER=metadata
DB_PASSWORD=change-me

# ─── 오브젝트 스토리지 (S3 호환: MinIO · SeaweedFS · AWS S3) ──────────────
# 수집 원본과 JSON-LD를 저장한다. 임베딩·검색만 쓸 경우 docker-compose의
# MinIO 기본값을 그대로 두면 된다.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_BUCKET=metadata

# ─── 네이버 개발자센터 (뉴스·블로그·쇼핑·페르소나) ────────────────────────
# https://developers.naver.com/apps 에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ─── YouTube Data API v3 ─────────────────────────────────────────────────
# https://console.cloud.google.com 에서 API 키 발급
# 일일 할당량은 GCP '프로젝트' 단위다. 예비 키가 별도 프로젝트일 때만
# 실제 할당량이 늘어난다(같은 프로젝트면 동일 쿼터를 공유한다).
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_API_KEY_BACKUP=
YOUTUBE_API_KEY_BACKUP2=

# ─── 임베딩 ──────────────────────────────────────────────────────────────
# CPU 고정이 기본이다. Apple Silicon MPS에서 배치 인코딩 시 벡터가 손상된다
# (docs/adr/016_Embedding_Model_And_Conventions.md).
EMBEDDING_DEVICE=cpu

# ─── 자막(STT) ───────────────────────────────────────────────────────────
# 수집 1회당 자막 생성에 쓸 시간 상한(초). 0이면 비활성.
YOUTUBE_TRANSCRIPT_BUDGET_SEC=600
